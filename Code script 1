local function CreateButton(name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = name
    btn.TextSize = 13
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = Container
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    ApplyRainbow(btn)

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(50, 100, 50)
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        end
        callback(active)
    end)
end

CreateButton("Bug Tiền (Farm Kill Giả Lập)", function(state)
    task.spawn(function()
        while state and task.wait(0.2) do
            pcall(function()
                for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
                    if rem:IsA("RemoteEvent") and (rem.Name:lower():find("money") or rem.Name:lower():find("cash") or rem.Name:lower():find("reward")) then
                        rem:FireServer(999999)
                    end
                end
            end)
        end
    end)
end)

CreateButton("Kill Aura (Quét & Tiêu Diệt Quái)", function(state)
    task.spawn(function()
        while state and task.wait(0.3) do
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if v:FindFirstChild("Humanoid") and v ~= char and v.Humanoid.Health > 0 then
                        local mRoot = v:FindFirstChild("HumanoidRootPart")
                        if mRoot and (mRoot.Position - root.Position).Magnitude < 100 then
                            for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
                                if tool:IsA("Tool") then
                                    tool:Activate()
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

CreateButton("Bất Tử (Tách Hitbox Tránh Đòn)", function(state)
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            if state then
                root.CFrame = root.CFrame + Vector3.new(0, 99999, 0)
            else
                root.CFrame = root.CFrame - Vector3.new(0, 99999, 0)
            end
        end
    end)
end)

CreateButton("Cơ Chế Bay (Safe Flight)", function(state)
    task.spawn(function()
        local bv
        while state do
            task.wait()
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if root and hum then
                    hum.PlatformStand = true
                    if not bv then
                        bv = Instance.new("BodyVelocity")
                        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        bv.Velocity = Vector3.new(0, 0, 0)
                        bv.Parent = root
                    end
                    bv.Velocity = Workspace.CurrentCamera.CFrame.LookVector * 50
                end
            end)
        end
        pcall(function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if root then
                for _, v in ipairs(root:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then v:Destroy() end
                end
            end
            if hum then hum.PlatformStand = false end
        end)
    end)
end)

