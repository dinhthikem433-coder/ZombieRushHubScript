end)

CreateButton("Kill Aura (Quét Tất Cả Có Máu)", function(state)
    task.spawn(function()
        while state and task.wait(0.1) do
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if v:FindFirstChild("Humanoid") and v ~= char and v.Humanoid.Health > 0 then
                        local mRoot = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                        if mRoot and (mRoot.Position - root.Position).Magnitude <= 1500 then
                            for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
                                if rem:IsA("RemoteEvent") and (rem.Name:lower():find("hit") or rem.Name:lower():find("damage") or rem.Name:lower():find("attack") or rem.Name:lower():find("shot")) then
                                    rem:FireServer(v, 99999)
                                end
                            end
                            v.Humanoid.Health = 0
                        end
                    end
                end
            end)
        end
    end)
end)

