AddBtn("Bring Mob (Gom Quái)", function(st)
    task.spawn(function()
        while st do
            task.wait(0.03)
            if not st then break end
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local targetPos = root.CFrame * CFrame.new(0, 0, -5)

                for _, v in ipairs(Workspace:GetDescendants()) do
                    if not st then break end
                    if v:IsA("Model") and v ~= char then
                        local hum = v:FindFirstChildOfClass("Humanoid")
                        local hrp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                        if hum and hum.Health > 0 and hrp then
                            local isP = false
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p.Character == v then isP = true end
                            end
                            if not isP and (hrp.Position - root.Position).Magnitude <= 2000 then
                                hrp.CFrame = targetPos
                                hrp.Velocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

