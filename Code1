local function ApplyRainbow(textObject)
    task.spawn(function()
        local tickCount = 0
        while textObject and textObject.Parent do
            tickCount = tickCount + 0.02
            textObject.TextColor3 = Color3.fromHSV(tickCount % 1, 1, 1)
            task.wait(0.03)
        end
    end)
end

local function ShowNotification(message)
    task.spawn(function()
        local notif = Instance.new("TextLabel")
        notif.Size = UDim2.new(0, 320, 0, 40)
        notif.Position = UDim2.new(0.5, -160, 0, 50)
        notif.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        notif.BackgroundTransparency = 0.3
        notif.Text = message
        notif.TextSize = 14
        notif.Font = Enum.Font.SourceSansBold
        notif.Parent = ScreenGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = notif

        ApplyRainbow(notif)

        local tweenService = game:GetService("TweenService")
        local info = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        local tweenIn = tweenService:Create(notif, info, {Position = UDim2.new(0.5, -160, 0, 100)})
        tweenIn:Play()
        task.wait(2)

        local tweenOut = tweenService:Create(notif, info, {Position = UDim2.new(0.5, -160, 0, 50), BackgroundTransparency = 1})
        tweenOut:Play()
        task.wait(0.5)
        notif:Destroy()
    end)
end

