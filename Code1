    local frames = 0
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        if tick() - lastTick >= 1 then
            local fps = math.floor(frames / (tick() - lastTick))
            local timeStr = os.date("%H:%M:%S")
            HeaderLabel.Text = "TikTok @ ✨Hoàng Sắc Thiểm Quang ✨\n[ FPS: " .. fps .. " | " .. timeStr .. " ]"
