AddBtn("Bring Mob (Gom Quái)", function(st)
    task.spawn(function()
        while st do
            task.wait(0.03)
            if not st then break end
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local targetPos = root.CFrame * CFrame.new(0, 0, -5)

                for _, v in ipairs(Workspace:GetDescendants()) do
                    if not st then break end
                    if v:IsA("Model") and v ~= char then
                        local hum = v:FindFirstChildOfClass("Humanoid")
                        local hrp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                        if hum and hum.Health > 0 and hrp then
                            local isP = false
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p.Character == v then isP = true end
                            end
                            if not isP and (hrp.Position - root.Position).Magnitude <= 3000 then
                                hrp.CFrame = targetPos
                                hrp.Velocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

AddBtn("Vô Hạn Đạn & Tốc Độ Bắn Cực Đại", function(st)
    task.spawn(function()
        while st do
            task.wait(0.01)
            if not st then break end
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then
                        tool:Activate()
                        for _, v in pairs(tool:GetDescendants()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local name = v.Name:lower()
                                if name:find("reload") then v.Value = 0 end
                                if name:find("ammo") or name:find("clip") then v.Value = 999 end
                                if name:find("fire") or name:find("rate") or name:find("speed") or name:find("delay") or name:find("cooldown") then
                                    v.Value = 0.0001
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

