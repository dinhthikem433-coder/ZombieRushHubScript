local flyActive, flyGui, flySpd = false, nil, 50
AddBtn("Cơ Chế Fly (Fly V3 Chuẩn)", function(st)
    flyActive = st
    task.spawn(function()
        if st then
            if flyGui then flyGui:Destroy() end
            flyGui = Instance.new("Frame", ScreenGui)
            flyGui.Size = UDim2.new(0, 180, 0, 90)
            flyGui.Position = UDim2.new(1, -200, 0.4, 0)
            flyGui.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            flyGui.Active = true flyGui.Draggable = true
            Instance.new("UICorner", flyGui).CornerRadius = UDim.new(0, 6)
            ApplyRainbow(flyGui)

            local spdBtn = Instance.new("TextButton", flyGui)
            spdBtn.Size = UDim2.new(0.9, 0, 0, 35)
            spdBtn.Position = UDim2.new(0.05, 0, 0, 10)
            spdBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            spdBtn.Text = "Tốc độ bay: " .. flySpd
            spdBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            spdBtn.Font = Enum.Font.SourceSansBold spdBtn.TextSize = 12
            Instance.new("UICorner", spdBtn).CornerRadius = UDim.new(0, 4)

            spdBtn.MouseButton1Click:Connect(function()
                flySpd = flySpd + 25 if flySpd > 150 then flySpd = 25 end
                spdBtn.Text = "Tốc độ bay: " .. flySpd
            end)

            local clsBtn = Instance.new("TextButton", flyGui)
            clsBtn.Size = UDim2.new(0.9, 0, 0, 35)
            clsBtn.Position = UDim2.new(0.05, 0, 0, 50)
            clsBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            clsBtn.Text = "Tắt Bảng Bay"
            clsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            clsBtn.Font = Enum.Font.SourceSansBold clsBtn.TextSize = 12
            Instance.new("UICorner", clsBtn).CornerRadius = UDim.new(0, 4)

            clsBtn.MouseButton1Click:Connect(function() flyActive = false if flyGui then flyGui:Destroy() end end)

            task.spawn(function()
                local bv, bg
                local keys = {W = false, S = false, A = false, D = false, Space = false, Shift = false}
                local ib = UserInputService.InputBegan:Connect(function(i)
                    if i.KeyCode == Enum.KeyCode.W then keys.W = true elseif i.KeyCode == Enum.KeyCode.S then keys.S = true
                    elseif i.KeyCode == Enum.KeyCode.A then keys.A = true elseif i.KeyCode == Enum.KeyCode.D then keys.D = true
                    elseif i.KeyCode == Enum.KeyCode.Space then keys.Space = true elseif i.KeyCode == Enum.KeyCode.LeftShift then keys.Shift = true end
                end)
                local ie = UserInputService.InputEnded:Connect(function(i)
                    if i.KeyCode == Enum.KeyCode.W then keys.W = false elseif i.KeyCode == Enum.KeyCode.S then keys.S = false
                    elseif i.KeyCode == Enum.KeyCode.A then keys.A = false elseif i.KeyCode == Enum.KeyCode.D then keys.D = false
                    elseif i.KeyCode == Enum.KeyCode.Space then keys.Space = false elseif i.KeyCode == Enum.KeyCode.LeftShift then keys.Shift = false end
                end)

                while flyActive and st do
                    RunService.RenderStepped:Wait()
                    pcall(function()
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChild("Humanoid")
                        if root and hum and hum.Health > 0 then
                            if not bv then bv = Instance.new("BodyVelocity", root) bv.MaxForce = Vector3.new(1e9, 1e9, 1e9) end
                            if not bg then bg = Instance.new("BodyGyro", root) bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9) end
                            local cam = Workspace.CurrentCamera.CFrame
                            local mv = Vector3.new()
                            if keys.W then mv = mv + cam.LookVector end
                            if keys.S then mv = mv - cam.LookVector end
                            if keys.A then mv = mv - cam.RightVector end
                            if keys.D then mv = mv + cam.RightVector end
                            if keys.Space then mv = mv + Vector3.new(0, 1, 0) end
                            if keys.Shift then mv = mv - Vector3.new(0, 1, 0) end
                            bv.Velocity = mv * flySpd
                            bg.CFrame = cam
                        else
                            flyActive = false
                        end
                    end)
                end
                if ib then ib:Disconnect() end if ie then ie:Disconnect() end
                if bv then bv:Destroy() end if bg then bg:Destroy() end
            end)
        else
            flyActive = false
            if flyGui then flyGui:Destroy() end
        end
    end)
end)

