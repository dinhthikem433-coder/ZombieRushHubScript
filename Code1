            titleFly.Size = UDim2.new(1, 0, 0, 30)
            titleFly.BackgroundTransparency = 1
            titleFly.Text = "FLY GUI V3 (3.0)"
            titleFly.TextColor3 = Color3.fromRGB(255, 255, 255)
            titleFly.Font = Enum.Font.SourceSansBold
            titleFly.TextSize = 12
            titleFly.Parent = flyGuiV3
            ApplyRainbow(titleFly)

            local closeFly = Instance.new("TextButton")
            closeFly.Size = UDim2.new(0.9, 0, 0, 35)
            closeFly.Position = UDim2.new(0.05, 0, 0, 45)
            closeFly.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            closeFly.Text = "Tắt Bay Nhanh"
            closeFly.TextColor3 = Color3.fromRGB(255, 255, 255)
            closeFly.Font = Enum.Font.SourceSansBold
            closeFly.TextSize = 12
            closeFly.Parent = flyGuiV3
            Instance.new("UICorner", closeFly).CornerRadius = UDim.new(0, 4)

            local flyingActive = true
            closeFly.MouseButton1Click:Connect(function()
                flyingActive = false
                if flyGuiV3 then flyGuiV3:Destroy() end
            end)

            task.spawn(function()
                local bv, bg
                while flyingActive and state do
                    task.wait()
                    pcall(function()
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChild("Humanoid")
                        if root and hum then
                            hum.PlatformStand = true
                            if not bv then
                                bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Velocity = Vector3.new(0, 0, 0)
                                bv.Parent = root
                            end
                            if not bg then
                                bg = Instance.new("BodyGyro")
                                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                                bg.CFrame = Workspace.CurrentCamera.CFrame
                                bg.Parent = root
                            end
                            
                            local cam = Workspace.CurrentCamera
                            local moveDir = hum.MoveDirection
                            local speed = hum.WalkSpeed * 1.5
                            bv.Velocity = (cam.CFrame.LookVector * (moveDir.Z * -speed)) + (cam.CFrame.RightVector * (moveDir.X * speed)) + Vector3.new(0, (moveDir.Y * speed), 0)
                            bg.CFrame = cam.CFrame
                            
                            local targetCF = root.CFrame - Vector3.new(0, 4, 0)
                            root.CFrame = root.CFrame:Lerp(targetCF, 0.25)
                        end
                    end)
                end
                
                if bv then bv:Destroy() end
                if bg then bg:Destroy() end
            end)

            while state and flyingActive do task.wait(0.1) end
            if flyGuiV3 then flyGuiV3:Destroy() end
            
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if root then
                    root.CFrame = root.CFrame + Vector3.new(0, 4, 0)
                end
                if hum then hum.PlatformStand = false end
            end)
        else
            if flyGuiV3 then flyGuiV3:Destroy() end
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                if root then
                    root.CFrame = root.CFrame + Vector3.new(0, 4, 0)
                end
                if hum then hum.PlatformStand = false end
            end)
        end
    end)
end)

CreateButton("No-Clip (Đi Xuyên Tường)", function(state)
    local noclipConnection
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end)
    else
        if noclipConnection then noclipConnection:Disconnect() end
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end)
    end
end)

