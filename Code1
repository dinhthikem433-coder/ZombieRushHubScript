task.spawn(function()
    local colors = {Color3.fromRGB(255, 50, 50), Color3.fromRGB(50, 255, 50), Color3.fromRGB(50, 150, 255), Color3.fromRGB(255, 220, 50), Color3.fromRGB(255, 100, 255)}
    for i = 1, 35 do
