local function AddBtn(name, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.Text = name
    b.TextSize = 12
    b.Font = Enum.Font.SourceSansBold
    b.Parent = Container
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    ApplyRainbow(b)

    local active = false
    b.MouseButton1Click:Connect(function()
        active = not active
        b.BackgroundColor3 = active and Color3.fromRGB(50, 100, 50) or Color3.fromRGB(30, 30, 30)
        ShowNotif(active and ("[✓] Bật: " .. name) or ("[✗] Tắt: " .. name))
        callback(active)
    end)
end

-- Bug Tiền Thật: Đã giới hạn mức trần 1,000,000 tiền an toàn tuyệt đối
AddBtn("Bug Tiền (Giới hạn 1 Triệu)", function(st)
    task.spawn(function()
        while st do
            task.wait(2.5)
            if not st then break end
            pcall(function()
                local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
                if leaderstats then
                    for _, stat in ipairs(leaderstats:GetChildren()) do
                        local name = stat.Name:lower()
                        if name:find("cash") or name:find("money") or name:find("coin") or name:find("point") then
                            if stat.Value < 1000000 then
                                stat.Value = stat.Value + 1000
                            end
                        end
                    end
                end
                for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
                    if not st then break end
                    if v:IsA("RemoteEvent") then
                        local n = v.Name:lower()
                        if n:find("addcash") or n:find("givemoney") or n:find("reward") then
                            v:FireServer(1000)
                        end
                    end
                end
            end)
        end
    end)
end)

-- Kill Aura Thật: Quét trọn vẹn toàn bộ Workspace an toàn
AddBtn("Kill Aura Thật (Real One-Hit)", function(st)
    task.spawn(function()
        local targetRemote = nil
        pcall(function()
            for _, r in ipairs(ReplicatedStorage:GetDescendants()) do
                if r:IsA("RemoteEvent") then
                    local rn = r.Name:lower()
                    if rn:find("damage") or rn:find("hit") or rn:find("shoot") then
                        targetRemote = r
                        break
                    end
                end
            end
        end)

        while st do
            task.wait(0.2)
            if not st then break end
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end

                for _, v in ipairs(Workspace:GetDescendants()) do
                    if not st then break end
                    local hum = v:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 and v ~= char then
                        local isP = false
                        for _, p in ipairs(Players:GetPlayers()) do if p.Character == v then isP = true end end
                        if not isP then
                            local mr = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                            if mr and (mr.Position - root.Position).Magnitude <= 100 then
                                Workspace.CurrentCamera.CFrame = CFrame.new(Workspace.CurrentCamera.CFrame.Position, mr.Position)
                                
                                if targetRemote then
                                    targetRemote:FireServer(v, 999999, mr.Position)
                                else
                                    hum.Health = 0
                                end
                                break 
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

local godConn = nil
AddBtn("Bất Tử (Safe GodMode)", function(st)
    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if st then
            if hum then
                if godConn then godConn:Disconnect() godConn = nil end
                godConn = hum.HealthChanged:Connect(function()
                    if hum.Health < hum.MaxHealth then 
                        hum.Health = hum.MaxHealth 
                    end
                end)
            end
            if char and not char:FindFirstChildOfClass("ForceField") then Instance.new("ForceField", char) end
        else
            if godConn then godConn:Disconnect() godConn = nil end
            if char then for _, f in ipairs(char:GetChildren()) do if f:IsA("ForceField") then f:Destroy() end end end
        end
    end)
end)

local flyActive, flyGui, flySpd = false, nil, 50
AddBtn("Cơ Chế Bay (Fly V3 Chuẩn)", function(st)
    flyActive = st
    task.spawn(function()
        if st then
            if flyGui then flyGui:Destroy() end
            flyGui = Instance.new("Frame", ScreenGui)
            flyGui.Size = UDim2.new(0, 180, 0, 90)
            flyGui.Position = UDim2.new(1, -200, 0.4, 0)
            flyGui.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            flyGui.Active = true flyGui.Draggable = true
            Instance.new("UICorner", flyGui).CornerRadius = UDim.new(0, 6)
            ApplyRainbow(flyGui)

            local spdBtn = Instance.new("TextButton", flyGui)
            spdBtn.Size = UDim2.new(0.9, 0, 0, 35)
            spdBtn.Position = UDim2.new(0.05, 0, 0, 10)
            spdBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            spdBtn.Text = "Tốc độ: " .. flySpd
            spdBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            spdBtn.Font = Enum.Font.SourceSansBold spdBtn.TextSize = 12
            Instance.new("UICorner", spdBtn).CornerRadius = UDim.new(0, 4)

            spdBtn.MouseButton1Click:Connect(function()
                flySpd = flySpd + 25 if flySpd > 150 then flySpd = 25 end
                spdBtn.Text = "Tốc độ: " .. flySpd
            end)

            local clsBtn = Instance.new("TextButton", flyGui)
            clsBtn.Size = UDim2.new(0.9, 0, 0, 35)
            clsBtn.Position = UDim2.new(0.05, 0, 0, 50)
            clsBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            clsBtn.Text = "Tắt Bảng Bay"
            clsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            clsBtn.Font = Enum.Font.SourceSansBold clsBtn.TextSize = 12
            Instance.new("UICorner", clsBtn).CornerRadius = UDim.new(0, 4)

            clsBtn.MouseButton1Click:Connect(function() flyActive = false if flyGui then flyGui:Destroy() end end)

            task.spawn(function()
                local bv, bg
                local keys = {W = false, S = false, A = false, D = false, Space = false, Shift = false}
                local ib = UserInputService.InputBegan:Connect(function(i)
                    if i.KeyCode == Enum.KeyCode.W then keys.W = true elseif i.KeyCode == Enum.KeyCode.S then keys.S = true
                    elseif i.KeyCode == Enum.KeyCode.A then keys.A = true elseif i.KeyCode == Enum.KeyCode.D then keys.D = true
                    elseif i.KeyCode == Enum.KeyCode.Space then keys.Space = true elseif i.KeyCode == Enum.KeyCode.LeftShift then keys.Shift = true end
                end)
                local ie = UserInputService.InputEnded:Connect(function(i)
                    if i.KeyCode == Enum.KeyCode.W then keys.W = false elseif i.KeyCode == Enum.KeyCode.S then keys.S = false
                    elseif i.KeyCode == Enum.KeyCode.A then keys.A = false elseif i.KeyCode == Enum.KeyCode.D then keys.D = false
                    elseif i.KeyCode == Enum.KeyCode.Space then keys.Space = false elseif i.KeyCode == Enum.KeyCode.LeftShift then keys.Shift = false end
                end)

                while flyActive and st do
                    task.wait()
                    pcall(function()
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChild("Humanoid")
                        if root and hum and hum.Health > 0 then
                            hum.PlatformStand = true
                            if not bv then bv = Instance.new("BodyVelocity", root) bv.MaxForce = Vector3.new(1e9, 1e9, 1e9) end
                            if not bg then bg = Instance.new("BodyGyro", root) bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9) end
                            local cam = Workspace.CurrentCamera.CFrame
                            local mv = Vector3.new()
                            if keys.W then mv = mv + cam.LookVector end
                            if keys.S then mv = mv - cam.LookVector end
                            if keys.A then mv = mv - cam.RightVector end
                            if keys.D then mv = mv + cam.RightVector end
                            if keys.Space then mv = mv + Vector3.new(0, 1, 0) end
                            if keys.Shift then mv = mv - Vector3.new(0, 1, 0) end
                            bv.Velocity = mv * flySpd
                            bg.CFrame = cam
                        else
                            flyActive = false
                        end
                    end)
                end
                if ib then ib:Disconnect() end if ie then ie:Disconnect() end
                if bv then bv:Destroy() end if bg then bg:Destroy() end
            end)
        else
            flyActive = false
            if flyGui then flyGui:Destroy() end
            pcall(function() LocalPlayer.Character.Humanoid.PlatformStand = false end)
        end
    end)
end)

local noclipConn = nil
AddBtn("No-Clip (Xuyên Tường Giữ Sàn)", function(st)
    if st then
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        noclipConn = RunService.Stepped:Connect(function()
            pcall(function()
                local char = LocalPlayer.Character
                if char then
                    for _, p in ipairs(char:GetDescendants()) do
                        if p:IsA("BasePart") and p.Name ~= "LeftFoot" and p.Name ~= "RightFoot" and p.Name ~= "LeftLowerLeg" and p.Name ~= "RightLowerLeg" then
                            p.CanCollide = false
                        end
                    end
                end
            end)
        end)
    else
        if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
        end)
    end
end)

