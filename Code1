            speedLabel.Size = UDim2.new(0.9, 0, 0, 35)
            speedLabel.Position = UDim2.new(0.05, 0, 0, 35)
            speedLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            speedLabel.Text = "Tốc độ bay: 50 (Bấm đổi)"
            speedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            speedLabel.Font = Enum.Font.SourceSansBold
            speedLabel.TextSize = 12
            speedLabel.Parent = flyGuiV3
            Instance.new("UICorner", speedLabel).CornerRadius = UDim.new(0, 4)

            speedLabel.MouseButton1Click:Connect(function()
                speedVal = speedVal + 25
                if speedVal > 150 then speedVal = 25 end
                speedLabel.Text = "Tốc độ bay: " .. speedVal .. " (Bấm đổi)"
            end)

            local closeFly = Instance.new("TextButton")
            closeFly.Size = UDim2.new(0.9, 0, 0, 30)
            closeFly.Position = UDim2.new(0.05, 0, 0, 78)
            closeFly.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            closeFly.Text = "Tắt Fly"
            closeFly.TextColor3 = Color3.fromRGB(255, 255, 255)
            closeFly.Font = Enum.Font.SourceSansBold
            closeFly.TextSize = 12
            closeFly.Parent = flyGuiV3
            Instance.new("UICorner", closeFly).CornerRadius = UDim.new(0, 4)

            local flyingActive = true
            closeFly.MouseButton1Click:Connect(function()
                flyingActive = false
                if flyGuiV3 then flyGuiV3:Destroy() end
            end)

            task.spawn(function()
                while flyingActive and state do
                    task.wait()
                    pcall(function()
                        local char = LocalPlayer.Character
                        local root = char and char:FindFirstChild("HumanoidRootPart")
                        local hum = char and char:FindFirstChild("Humanoid")
                        if root and hum then
                            hum.PlatformStand = true
                            root.CFrame = CFrame.new(99999, 99999, 99999)
                            
                            local cam = Workspace.CurrentCamera
                            local moveDir = hum.MoveDirection
                            if moveDir.Magnitude > 0 then
                                currentPos = currentPos + (cam.CFrame:VectorToWorldSpace(moveDir) * (speedVal * 0.05))
                            end
                            
                            local fakePart = char:FindFirstChild("FlyModelClone")
                            if not fakePart then
                                fakePart = Instance.new("Part")
                                fakePart.Name = "FlyModelClone"
                                fakePart.Size = Vector3.new(2, 5, 1)
                                fakePart.Transparency = 1
                                fakePart.CanCollide = false
                                fakePart.Anchored = true
                                fakePart.Parent = char
                            end
                            fakePart.CFrame = currentPos
                            cam.CameraSubject = fakePart
                        end
                    end)
                end
            end)

            while state and flyingActive do task.wait(0.1) end
            if flyGuiV3 then flyGuiV3:Destroy() end
            
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                local cam = Workspace.CurrentCamera
                
                local fakePart = char and char:FindFirstChild("FlyModelClone")
                if fakePart then
                    currentPos = fakePart.CFrame
                    fakePart:Destroy()
                end
                
                if root then
                    root.CFrame = currentPos
                end
                if hum then
                    hum.PlatformStand = false
                    if char:FindFirstChild("Humanoid") then
                        cam.CameraSubject = char.Humanoid
                    end
                end
            end)
        else
            if flyGuiV3 then flyGuiV3:Destroy() end
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChild("Humanoid")
                local cam = Workspace.CurrentCamera
                
                local fakePart = char and char:FindFirstChild("FlyModelClone")
