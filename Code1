local function AddBtn(name, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 40)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.Text = name
    b.TextSize = 12
    b.Font = Enum.Font.SourceSansBold
    b.Parent = Container
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    ApplyRainbow(b)

    local active = false
    b.MouseButton1Click:Connect(function()
        active = not active
        b.BackgroundColor3 = active and Color3.fromRGB(50, 100, 50) or Color3.fromRGB(30, 30, 30)
        ShowNotif(active and ("[✓] Bật: " .. name) or ("[✗] Tắt: " .. name))
        callback(active)
    end)
end

AddBtn("Bring Mob (Gom Quái 1000 Studs)", function(st)
    task.spawn(function()
        while st do
            task.wait(0.02)
            if not st then break end
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local targetPos = root.CFrame * CFrame.new(0, 0, -8)

                for _, v in ipairs(Workspace:GetDescendants()) do
                    if not st then break end
                    if v:IsA("Model") and v ~= char then
                        local hum = v:FindFirstChildOfClass("Humanoid")
                        local hrp = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Head")
                        if hum and hum.Health > 0 and hrp then
                            local isP = false
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p.Character == v then isP = true end
                            end
                            if not isP and (hrp.Position - root.Position).Magnitude <= 1000 then
                                hrp.CFrame = targetPos
                                hrp.Velocity = Vector3.new(0, 0, 0)
                            end
                        end
                    end
                end
            end)
        end
    end)
end)

