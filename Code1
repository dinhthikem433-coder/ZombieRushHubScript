local flying, ctrl, speeds = false, {f = 0, b = 0, l = 0, r = 0}, 50
local flyGui = nil

AddBtn("Cơ Chế Fly V3 Gốc Chuẩn", function(st)
    flying = st
    task.spawn(function()
        if st then
            if flyGui then flyGui:Destroy() end
            flyGui = Instance.new("Frame", ScreenGui)
            flyGui.Size = UDim2.new(0, 180, 0, 90)
            flyGui.Position = UDim2.new(1, -200, 0.4, 0)
            flyGui.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            flyGui.Active = true flyGui.Draggable = true
            Instance.new("UICorner", flyGui).CornerRadius = UDim.new(0, 6)
            ApplyRainbow(flyGui)

            local spdBtn = Instance.new("TextButton", flyGui)
            spdBtn.Size = UDim2.new(0.9, 0, 0, 35)
            spdBtn.Position = UDim2.new(0.05, 0, 0, 10)
            spdBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            spdBtn.Text = "Tốc độ: " .. speeds
            spdBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            spdBtn.Font = Enum.Font.SourceSansBold spdBtn.TextSize = 12
            Instance.new("UICorner", spdBtn).CornerRadius = UDim.new(0, 4)

            spdBtn.MouseButton1Click:Connect(function()
                PlayClickSound()
                speeds = speeds + 25 if speeds > 150 then speeds = 50 end
                spdBtn.Text = "Tốc độ: " .. speeds
            end)

            local clsBtn = Instance.new("TextButton", flyGui)
            clsBtn.Size = UDim2.new(0.9, 0, 0, 35)
            clsBtn.Position = UDim2.new(0.05, 0, 0, 50)
            clsBtn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            clsBtn.Text = "Tắt Bảng Bay"
            clsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            clsBtn.Font = Enum.Font.SourceSansBold clsBtn.TextSize = 12
            Instance.new("UICorner", clsBtn).CornerRadius = UDim.new(0, 4)

            clsBtn.MouseButton1Click:Connect(function()
                PlayClickSound()
                flying = false
                if flyGui then flyGui:Destroy() end
            end)

            task.spawn(function()
                local lrg
                local bg, bv
                local function startFly()
                    local char = LocalPlayer.Character
                    if not char then return end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    if bg then bg:Destroy() end
                    if bv then bv:Destroy() end
                    bg = Instance.new("BodyGyro", root)
                    bv = Instance.new("BodyVelocity", root)
                    bg.P = 9e4
                    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
                    bg.cframe = root.CFrame
                    bv.velocity = Vector3.new(0, 0, 0)
                    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
                    lrg = RunService.RenderStepped:Connect(function()
                        if not flying then
                            if bg then bg:Destroy() end
                            if bv then bv:Destroy() end
                            if lrg then lrg:Disconnect() end
                            return
                        end
                        pcall(function()
                            local hum = char:FindFirstChildOfClass("Humanoid")
                            if hum then hum.PlatformStand = true end
                            local cam = Workspace.CurrentCamera
                            if ctrl.f + ctrl.b ~= 0 or ctrl.l + ctrl.r ~= 0 then
                                bv.velocity = ((cam.CFrame.LookVector * (ctrl.f + ctrl.b)) + ((cam.CFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).Position) - cam.CFrame.Position)) * speeds
                                bg.cframe = cam.CFrame
                            else
                                bv.velocity = Vector3.new(0, 0.1, 0)
                                bg.cframe = cam.CFrame
                            end
                        end)
                    end)
                end

                local ib = UserInputService.InputBegan:Connect(function(i)
                    if i.KeyCode == Enum.KeyCode.W then ctrl.f = 1 elseif i.KeyCode == Enum.KeyCode.S then ctrl.b = -1
                    elseif i.KeyCode == Enum.KeyCode.A then ctrl.l = -1 elseif i.KeyCode == Enum.KeyCode.D then ctrl.r = 1 end
                end)
                local ie = UserInputService.InputEnded:Connect(function(i)
                    if i.KeyCode == Enum.KeyCode.W then ctrl.f = 0 elseif i.KeyCode == Enum.KeyCode.S then ctrl.b = 0
                    elseif i.KeyCode == Enum.KeyCode.A then ctrl.l = 0 elseif i.KeyCode == Enum.KeyCode.D then ctrl.r = 0 end
                end)

                startFly()
                while flying and st do
                    task.wait(0.1)
                end
                if ib then ib:Disconnect() end if ie then ie:Disconnect() end
                if lrg then lrg:Disconnect() end
                if bg then bg:Destroy() end if bv then bv:Destroy() end
                pcall(function() LocalPlayer.Character.Humanoid.PlatformStand = false end)
            end)
        else
            flying = false
            if flyGui then flyGui:Destroy() end
            pcall(function() LocalPlayer.Character.Humanoid.PlatformStand = false end)
        end
    end)
end)

